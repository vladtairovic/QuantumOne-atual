# Copie para .env. Nenhuma busca web é usada; o Gemini é opcional (sem chave, a resposta é local).
API_PORT=8000
CHROMA_COLLECTION=qiskit_documentacao_multilingue
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GROWUP_PERMITIR_DOWNLOAD=1
CHROMA_STARTUP_TIMEOUT=120
CHROMA_HTTP_TIMEOUT_SECONDS=30
API_TIMEOUT_SECONDS=60
# Deixe vazio até a equipe calibrar um limiar de relevância.
RAG_MAX_DISTANCE=

# Nunca publique a chave. Sem chave, /query responde de forma extrativa com a base local.
GEMINI_API_KEY=
# auto: usa Gemini se houver chave; local: nunca chama LLM (100% offline).
QONE_LLM=auto
# 1: se o Gemini faltar ou falhar, responde localmente; 0: retorna 503 LLM_NOT_CONFIGURED.
QONE_LOCAL_FALLBACK=1
# hibrido (vetorial + BM25), vetorial ou lexical.
RAG_MODO=hibrido
# Fração mínima dos termos da pergunta que os trechos precisam cobrir.
RAG_MIN_COBERTURA=0.34
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=40
GROWUP_MAX_CONTEXT_CHARS=12000
MAX_CIRCUIT_LINES=2500
MAX_QUBITS=32
MAX_CLASSICAL_BITS=256
MAX_CIRCUIT_GATES=10000
MAX_CIRCUIT_DEPTH=10000
MAX_CODE_SIZE_BYTES=524288
OPTIMIZATION_TIMEOUT_SECONDS=60
MAX_CONCURRENT_OPTIMIZATIONS=1
QISKIT_WORKER_MEMORY_MB=1536
MAX_PYTHON_STEPS=200000
MAX_EQUIVALENCE_QUBITS=8
MAX_EQUIVALENCE_OPERATIONS=1000
API_MEMORY_LIMIT=2g
API_CPU_LIMIT=2

FRONTEND_PORT=3000

# Atualização da documentação: processo administrativo separado.
# Rode manualmente: docker compose exec api python -m rag.sincronizar_conhecimento
# 1 reativa a coleta periódica (acessa os sites do catálogo, sem API de busca).
KNOWLEDGE_AUTO_SYNC=0
KNOWLEDGE_SYNC_INTERVAL_SECONDS=604800
